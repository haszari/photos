---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { url } from '../lib/url';
import RoomCorner from '../components/RoomCorner.astro';
import HomeLink from '../components/HomeLink.astro';
import SiteNav from '../components/SiteNav.astro';
import { CREATOR, PHOTO_LICENSE, SITE_URL } from '../lib/license';

interface Props {
	/** Document title (plus " Photos") and, by default, the visible heading. */
	title?: string;
	/** Heading text when it differs from the document title. */
	heading?: string;
	description?: string;
	/** Absolute path of this page, used for licence metadata. */
	path?: string;
	/** External page for the heading, when the record has one. */
	headingHref?: string;
	/** Show the external indicator next to the heading. */
	headingExternal?: boolean;
	/** Keep an h1 for structure and screen readers without showing it. */
	hideHeading?: boolean;
}

const {
	title,
	heading,
	description,
	path = '',
	headingHref,
	headingExternal = false,
	hideHeading = false,
} = Astro.props;
const headingText = heading ?? title ?? '';
const pageTitle = title ? `${title} Photos` : 'Photos';
const canonical = new URL(path, SITE_URL).href;
const siteJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: pageTitle,
	url: canonical,
	license: PHOTO_LICENSE.url,
	creator: { '@type': 'Person', name: CREATOR.name, url: CREATOR.url },
	copyrightHolder: { '@type': 'Person', name: CREATOR.name },
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<Font cssVariable="--font-sans" preload />
		{/* Marks a script-capable browser before first paint, so the photo page can
		    hide its media until it has loaded without hiding it from anyone else. */}
		<script is:inline>document.documentElement.classList.add('js');</script>
		<ClientRouter />
		<title>{pageTitle}</title>
		{description && <meta name="description" content={description} />}
		<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
		<link rel="icon" href={url('favicon.ico')} sizes="32x32" />
		<link rel="license" href={PHOTO_LICENSE.url} title={PHOTO_LICENSE.short} />
		<link rel="canonical" href={canonical} />
		<script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
		<slot name="head" />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<RoomCorner />
		<div class="shell">
			<header class="topbar">
				<div class="topbar__title">
					<HomeLink />
					<h1 class={hideHeading ? 'topbar__heading--hidden' : undefined}>
						{
							headingHref ? (
								<a href={headingHref} rel="noopener noreferrer">
									{headingText}
									{headingExternal && (
										<span class="external-mark" aria-hidden="true">
											↗
										</span>
									)}
								</a>
							) : (
								headingText
							)
						}
						<slot name="heading-icon" />
					</h1>
				</div>
				<SiteNav />
			</header>
			<slot />
		</div>
	</body>
</html>
