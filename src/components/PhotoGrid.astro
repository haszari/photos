---
import PhotoMedia from './PhotoMedia.astro';
import type { Photo } from '../lib/photos';
import { photoHref } from '../lib/photos';
import { route } from '../lib/url';
import { gridColumns, gridStyle } from '../lib/layout';

interface Props {
	photos: Photo[];
	/** How many assets to load eagerly, for the initial viewport. */
	eagerCount?: number;
	sizes?: string;
}

const { photos, eagerCount = 2, sizes } = Astro.props;

const columns = gridColumns(photos.length);
const resolvedSizes =
	sizes ??
	(columns === 1
		? '100vw'
		: columns === 2
			? '(max-width: 560px) 100vw, 50vw'
			: '(max-width: 560px) 100vw, (max-width: 900px) 50vw, 33vw');
---

<div class="grid-frame">
	<div class="masonry" style={gridStyle(photos.length)}>
		{
			photos.map((photo, index) => (
				<div class="masonry__item">
					<a href={route(photoHref(photo))}>
						<PhotoMedia
							photo={photo}
							sizes={resolvedSizes}
							loading={index < eagerCount ? 'eager' : 'lazy'}
						/>
					</a>
				</div>
			))
		}
	</div>
</div>
