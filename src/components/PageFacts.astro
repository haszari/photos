---
/**
 * Facts line and optional body for a record page.
 *
 * The page title lives in the top bar (see Base.astro), so this block starts
 * directly with the facts: date, place, links, and any body prose.
 */
interface Props {
	/** Render the default slot as body text; false for records with no body. */
	body?: boolean;
}

const { body = false } = Astro.props;
const hasFacts = Astro.slots.has('facts');
---

{
	(hasFacts || body) && (
		<header class="page-facts">
			{hasFacts && (
				<p class="facts">
					<slot name="facts" />
				</p>
			)}
			{body && (
				<div class="prose">
					<slot />
				</div>
			)}
		</header>
	)
}
