---
import PhotoMedia from './PhotoMedia.astro';
import type { Photo } from '../lib/photos';
import { route } from '../lib/url';

interface Item {
	href: string;
	label: string;
	photo?: Photo;
}

interface Props {
	items: Item[];
}

const { items } = Astro.props;
---

<ul class="entity-list">
	{
		items.map((item) => (
			<li>
				<a href={route(item.href)}>
					{item.photo && (
						<PhotoMedia
							photo={item.photo}
							widths={[240, 480]}
							sizes="(max-width: 560px) 50vw, 240px"
							quality={78}
						/>
					)}
					<span>{item.label}</span>
				</a>
			</li>
		))
	}
</ul>
