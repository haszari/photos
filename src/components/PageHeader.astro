---
/**
 * Shared page header: title, one facts line, optional body text.
 * Every entity page uses this so headings sit at the same inset and rhythm.
 */
interface Props {
	title: string;
	/** Heading level, for pages nested under an index. */
	level?: 1 | 2;
	/** Render the default slot as body text; false for records with no body. */
	body?: boolean;
}

const { title, level = 1, body = false } = Astro.props;
const Heading = `h${level}` as 'h1' | 'h2';
const hasFacts = Astro.slots.has('facts');
---

<header class="page-header">
	<Heading>{title}</Heading>
	{hasFacts && (
		<p class="facts">
			<slot name="facts" />
		</p>
	)}
	{
		body && (
			<div class="prose">
				<slot />
			</div>
		)
	}
</header>
