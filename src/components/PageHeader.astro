---
/**
 * Shared page header: title, one facts line, optional body text.
 *
 * A record with external links renders its title as the primary link. With a
 * single link the title carries an external indicator; with several, the first
 * is the title link and the rest are listed in the facts line.
 */
interface Props {
	title: string;
	/** Heading level, for pages nested under an index. */
	level?: 1 | 2;
	/** Render the default slot as body text; false for records with no body. */
	body?: boolean;
	/** External page for the title, if the record has one. */
	href?: string;
	/** Show the external indicator next to the title. */
	external?: boolean;
}

const { title, level = 1, body = false, href, external = false } = Astro.props;
const Heading = `h${level}` as 'h1' | 'h2';
const hasFacts = Astro.slots.has('facts');
---

<header class="page-header">
	<Heading>
		{
			href ? (
				<a href={href} rel="noopener noreferrer">
					{title}
					{external && (
						<span class="external-mark" aria-hidden="true">
							↗
						</span>
					)}
				</a>
			) : (
				title
			)
		}
	</Heading>
	{hasFacts && (
		<p class="facts">
			<slot name="facts" />
		</p>
	)}
	{
		body && (
			<div class="prose">
				<slot />
			</div>
		)
	}
</header>
