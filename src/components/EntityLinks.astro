---
/**
 * External pages for a record, rendered in its facts line. Each link is a
 * plain URL; the label is its hostname (`citygallery.org.nz`).
 */
interface Props {
	links: string[];
}

const { links } = Astro.props;

function labelFor(url: string): string {
	try {
		return new URL(url).hostname.replace(/^www\./, '');
	} catch {
		return url;
	}
}
---

{
	links.map((url) => (
		<span>
			<a href={url} rel="noopener noreferrer">
				{labelFor(url)}
			</a>
		</span>
	))
}
