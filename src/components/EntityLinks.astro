---
/**
 * External pages for a record. Rendered inside a page's facts line as plain
 * links: a supplied label wins, otherwise the hostname (`citygallery.org.nz`).
 */
interface Link {
	label?: string;
	url: string;
}

interface Props {
	links: Link[];
}

const { links } = Astro.props;

function labelFor(link: Link): string {
	if (link.label) return link.label;
	try {
		return new URL(link.url).hostname.replace(/^www\./, '');
	} catch {
		return link.url;
	}
}
---

{
	links.map((link) => (
		<span>
			<a href={link.url} rel="noopener noreferrer">
				{labelFor(link)}
			</a>
		</span>
	))
}
