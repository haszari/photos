---
/**
 * Tag cloud: one pill per tag, sized by how many photos carry it.
 *
 * The curve is cratecaddy's: font-size = 0.5 * (ln(count) + 1) em, so each
 * doubling of a tag's use adds a constant 0.5·ln2 ≈ 0.35em. Absolute size comes
 * from the container's font-size (see .tag-cloud), which keeps one tag legible
 * while a heavily used one grows without ever dominating.
 */
import type { TagInfo } from '../lib/tags';
import { route } from '../lib/url';

interface Props {
	tags: TagInfo[];
}

const { tags } = Astro.props;

const pillSize = (count: number) => (0.5 * (Math.log(Math.max(count, 1)) + 1)).toFixed(3);
---

<ul class="tag-cloud">
	{
		tags.map((tag) => (
			<li style={`font-size: ${pillSize(tag.count)}em`}>
				<a class="tag-pill" href={route(`tags/${tag.slug}/`)}>
					{tag.label}
					{tag.count > 1 && (
						<span class="tag-pill__count" aria-label={`${tag.count} photos`}>
							{tag.count}
						</span>
					)}
				</a>
			</li>
		))
	}
</ul>
