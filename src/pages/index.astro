---
import Base from '../layouts/Base.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { getPhotos } from '../lib/photos';
import { groupPhotos } from '../lib/groups';
import { formatDate } from '../lib/format';
import { route } from '../lib/url';

const photos = await getPhotos();
const groups = await groupPhotos(photos);
---

<Base>
	<main class="page gallery">
		<h1 class="visually-hidden">All photos</h1>
		{
			groups.map((group) => (
				<section>
					<PhotoGrid photos={group.photos} />
					<p class="group-caption">
						<time datetime={group.date.toISOString().slice(0, 10)}>{formatDate(group.date)}</time>
						{group.gallery && (
							<>
								{' — '}
								<a href={route(`galleries/${group.gallery.id}/`)}>{group.gallery.data.name}</a>
							</>
						)}
						{!group.gallery && group.visit?.data.title && ` — ${group.visit.data.title}`}
					</p>
				</section>
			))
		}
		{photos.length === 0 && <p>No photos yet.</p>}
	</main>
</Base>
