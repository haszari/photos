---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PhotoGroup from '../../components/PhotoGroup.astro';
import EntityLinks from '../../components/EntityLinks.astro';
import { getIndex } from '../../lib/content';
import { groupPhotos } from '../../lib/groups';
import { photosForLocation } from '../../lib/queries';
import { formatDate } from '../../lib/format';
import { route } from '../../lib/url';

export async function getStaticPaths() {
	const { locations } = await getIndex();
	return locations.map((location) => ({ params: { id: location.id }, props: { location } }));
}

const { location } = Astro.props;
const [photos, note] = await Promise.all([photosForLocation(location.id), render(location)]);
const groups = await groupPhotos(photos);
const facts = [location.data.address, location.data.city, location.data.country].filter(Boolean);
const hasBody = Boolean(location.body?.trim());
const links = location.data.links ?? [];
const primary = links[0];
---

<Base
	path={`locations/${location.id}/`}
	title={location.data.name}
	description={`Photos taken at ${location.data.name}.`}
>
	<main class="page stack">
		<PageHeader
			title={location.data.name}
			body={hasBody}
			href={primary?.url}
			external={links.length === 1}
		>
			{
				(facts.length > 0 || links.length > 1) && (
					<Fragment slot="facts">
						{facts.map((fact) => (
							<span>{fact}</span>
						))}
						{links.length > 1 && <EntityLinks links={links} />}
					</Fragment>
				)
			}
			<note.Content />
		</PageHeader>

		{
			groups.map((group) => (
				<PhotoGroup photos={group.photos}>
					<Fragment slot="heading">
						<span>
							<time datetime={group.date.toISOString().slice(0, 10)}>
								{group.visit ? (
									<a href={route(`visits/${group.visit.id}/`)}>{formatDate(group.date)}</a>
								) : (
									formatDate(group.date)
								)}
							</time>
						</span>
						{group.visit?.data.title && <span>{group.visit.data.title}</span>}
					</Fragment>
				</PhotoGroup>
			))
		}
		{photos.length === 0 && <p>No photos yet.</p>}
	</main>
</Base>
