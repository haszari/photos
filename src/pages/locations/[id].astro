---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageFacts from '../../components/PageFacts.astro';
import TypeIcon from '../../components/TypeIcon.astro';
import PhotoGroup from '../../components/PhotoGroup.astro';
import EntityLinks from '../../components/EntityLinks.astro';
import { getIndex } from '../../lib/content';
import { groupPhotos } from '../../lib/groups';
import { exhibitionsForLocation, photosForLocation } from '../../lib/queries';
import { formatDate, formatDateRange } from '../../lib/format';
import { route } from '../../lib/url';

export async function getStaticPaths() {
	const { locations } = await getIndex();
	return locations.map((location) => ({ params: { id: location.id }, props: { location } }));
}

const { location } = Astro.props;
const [photos, exhibitions, note] = await Promise.all([
	photosForLocation(location.id),
	exhibitionsForLocation(location.id),
	render(location),
]);
const groups = await groupPhotos(photos);
const facts = [location.data.address, location.data.city, location.data.country].filter(Boolean);
const hasBody = Boolean(location.body?.trim());
const links = location.data.links ?? [];
const primary = links[0];
---

<Base
	path={`locations/${location.id}/`}
	title={location.data.name}
	description={`Photos taken at ${location.data.name}.`}
	headingHref={primary}
	headingExternal={links.length === 1}
>
	<TypeIcon slot="heading-icon" type="location" />
	<main class="page stack">
		<PageFacts body={hasBody}>
			{
				(facts.length > 0 || links.length > 1) && (
					<Fragment slot="facts">
						{facts.map((fact) => (
							<span>{fact}</span>
						))}
						{links.length > 1 && <EntityLinks links={links.slice(1)} />}
					</Fragment>
				)
			}
						<note.Content />
		</PageFacts>

		{
			exhibitions.length > 0 && (
				<section class="exhibition-history">
					<h2>Exhibitions</h2>
					<ul>
						{
							exhibitions.map((exhibition) => (
								<li>
									<a href={route(`exhibitions/${exhibition.id}/`)}>
										{exhibition.data.name}
									</a>
									{exhibition.data.startDate && (
										<span class="exhibition-history__dates">
											{formatDateRange(exhibition.data.startDate, exhibition.data.endDate)}
										</span>
									)}
								</li>
							))
						}
					</ul>
				</section>
			)
		}

		{
			groups.map((group) => (
				<PhotoGroup photos={group.photos}>
					<Fragment slot="heading">
						<span>
							<time datetime={group.date.toISOString().slice(0, 10)}>
								{group.visit ? (
									<a href={route(`visits/${group.visit.id}/`)}>{formatDate(group.date)}</a>
								) : (
									formatDate(group.date)
								)}
							</time>
						</span>
						{group.visit?.data.name && <span>{group.visit.data.name}</span>}
					</Fragment>
				</PhotoGroup>
			))
		}
		{photos.length === 0 && <p>No photos yet.</p>}
	</main>
</Base>
