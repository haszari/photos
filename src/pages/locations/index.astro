---
import Base from '../../layouts/Base.astro';
import TypeIcon from '../../components/TypeIcon.astro';
import EntityList from '../../components/EntityList.astro';
import { getIndex } from '../../lib/content';
import { photosForLocation, featuredPhoto } from '../../lib/queries';

const { locations } = await getIndex();

const items = await Promise.all(
	locations.map(async (location) => {
		const photos = await photosForLocation(location.id);
		return {
			href: `locations/${location.id}/`,
			label: location.data.name,
			photo: featuredPhoto(photos, location.data.featuredPhoto),
		};
	}),
);
---

<Base path="locations/" title="Locations">
	<TypeIcon slot="heading-icon" type="location" />
	<main class="page stack">
		<EntityList items={items} />
		{items.length === 0 && <p>No locations yet.</p>}
	</main>
</Base>
