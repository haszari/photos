---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { getPhotos, photoHref, altText } from '../../../lib/photos';
import PhotoMedia from '../../../components/PhotoMedia.astro';
import { getRelations } from '../../../lib/relations';
import { photoLicenseJsonLd, PHOTO_LICENSE, SITE_URL } from '../../../lib/license';
import { getTags, getTagRegistry, photoTags } from '../../../lib/tags';
import { formatDate } from '../../../lib/format';
import { route } from '../../../lib/url';

export async function getStaticPaths() {
	const photos = await getPhotos();
	return photos.map((photo) => ({
		params: { date: photo.datestamp, slug: photo.slug },
		props: { photo },
	}));
}

const { photo } = Astro.props;
const [relations, registry, allTags] = await Promise.all([
	getRelations(photo),
	getTagRegistry(),
	getTags(),
]);

const note = photo.entry ? await render(photo.entry) : undefined;
const hasNote = Boolean(photo.entry?.body?.trim());
const data = photo.entry?.data;
const tagSlugs = photoTags(data?.tags, registry);
const tagMap = new Map(allTags.map((tag) => [tag.slug, tag]));
const tags = tagSlugs.map((slug) => tagMap.get(slug)).filter(Boolean);

const workTitle = relations.works[0]?.data.title;
const heading = workTitle ?? formatDate(photo.date, 'long');
const pageTitle = workTitle ? `${workTitle} ${formatDate(photo.date)}` : formatDate(photo.date, 'long');
const alt = altText(photo);
const description = data?.sourceCaption ?? alt;
const placeDate = relations.visit?.data.visitedAt ?? photo.date;

// A show named after the artist adds nothing next to the artist name in the
// card, so skip it there. It still appears on the visit page.
const artistNames = new Set(relations.artists.map((artist) => artist.data.name.trim().toLowerCase()));
const cardExhibitions = relations.exhibitions.filter(
	(exhibition) => !artistNames.has(exhibition.data.title.trim().toLowerCase()),
);
---

<Base title={pageTitle} description={description || undefined} path={photoHref(photo)}>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				...photoLicenseJsonLd(),
				name: heading,
				url: new URL(photoHref(photo), SITE_URL).href,
				caption: description || undefined,
				license: PHOTO_LICENSE.url,
			})}
		/>
	</Fragment>
	<main class="photo-page">
		<h1 class="visually-hidden">{heading}</h1>
		<div class="photo-page__inner">
		<figure class="photo-page__figure">
			<PhotoMedia
				photo={photo}
				widths={[960, 1600, 2400]}
				sizes="(max-width: 720px) 100vw, 78vw"
				loading="eager"
				priority
			/>
		</figure>

		<aside class="photo-meta">
			<div class="photo-meta__box">
				{
					relations.artists.length > 0 && (
						<p class="photo-meta__line photo-meta__line--artist">
							{relations.artists.map((artist, index) => (
								<>
									{index > 0 && ' '}
									<a href={route(`artists/${artist.id}/`)}>{artist.data.name}</a>
								</>
							))}
						</p>
					)
				}
				{
					relations.works.length > 0 && (
						<p class="photo-meta__line photo-meta__line--muted photo-meta__line--work">
							{relations.works.map((work, index) => (
								<>
									{index > 0 && ' '}
									<a href={route(`works/${work.id}/`)}>{work.data.title}</a>
									{work.data.date && (
										<span class="photo-meta__year">{` ${work.data.date}`}</span>
									)}
								</>
							))}
						</p>
					)
				}
				{
					(cardExhibitions.length > 0 || relations.location || placeDate) && (
						<p class="photo-meta__line photo-meta__line--muted photo-meta__line--place">
							{cardExhibitions.map((exhibition, index) => (
								<>
									{index > 0 && ' '}
									<span class="photo-meta__exhibition">
										<a href={route(`exhibitions/${exhibition.id}/`)}>
											{exhibition.data.title}
										</a>
									</span>
								</>
							))}
							{cardExhibitions.length > 0 && (relations.location || placeDate) && ' '}
							{relations.location && (
								<span class="photo-meta__location">
									<a href={route(`locations/${relations.location.id}/`)}>
										{relations.location.data.name}
									</a>
								</span>
							)}
							{placeDate && (
								<span class="photo-meta__date">{` ${formatDate(placeDate)}`}</span>
							)}
						</p>
					)
				}
				{
					tags.length > 0 && (
						<p class="photo-meta__line photo-meta__line--tags">
							{tags.map((tag, index) => (
								<>
									{index > 0 && ', '}
									<a href={route(`tags/${tag!.slug}/`)}>{tag!.label}</a>
								</>
							))}
						</p>
					)
				}
				{
					hasNote && note?.Content && (
						<div class="prose photo-meta__note">
							<note.Content />
						</div>
					)
				}
			</div>
			<p class="visually-hidden">
				<a href={route('')}>All photos</a>
			</p>
		</aside>
		</div>
	</main>
</Base>
