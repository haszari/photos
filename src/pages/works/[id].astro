---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageFacts from '../../components/PageFacts.astro';
import TypeIcon from '../../components/TypeIcon.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import EntityLinks from '../../components/EntityLinks.astro';
import { getIndex } from '../../lib/content';
import { route } from '../../lib/url';
import { photosForWork } from '../../lib/queries';
import { workArtists } from '../../lib/relations';

export async function getStaticPaths() {
	const { works } = await getIndex();
	return works.map((work) => ({ params: { id: work.id }, props: { work } }));
}

const { work } = Astro.props;
const [photos, note, index] = await Promise.all([
	photosForWork(work.id),
	render(work),
	getIndex(),
]);

const artists = workArtists(index, work);
const hasBody = Boolean(work.body?.trim());
const links = work.data.links ?? [];
const primary = links[0];
---

<Base
	path={`works/${work.id}/`}
	title={work.data.name}
	description={`Photos of ${work.data.name}.`}
	headingHref={primary}
	headingExternal={links.length === 1}
>
	<main class="page stack">
		<PageFacts body={hasBody}>
			{
				(work.data.date || artists.length > 0 || links.length > 1) && (
					<Fragment slot="facts">
						{work.data.date && <span>{work.data.date}</span>}
						{artists.map((artist) => (
							<span>
								<a href={route(`artists/${artist.id}/`)}>{artist.data.name}</a>
								<TypeIcon type="artist" class="icon-inline" />
							</span>
						))}
						{links.length > 1 && <EntityLinks links={links} />}
					</Fragment>
				)
			}
			<note.Content />
		</PageFacts>
		<PhotoGrid photos={photos} />
		{photos.length === 0 && <p>No photos yet.</p>}
	</main>
</Base>
