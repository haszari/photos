---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import TypeIcon from '../../components/TypeIcon.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import EntityLinks from '../../components/EntityLinks.astro';
import { getIndex } from '../../lib/content';
import { photosForExhibition } from '../../lib/queries';
import { formatDateRange } from '../../lib/format';

export async function getStaticPaths() {
	const { exhibitions } = await getIndex();
	return exhibitions.map((exhibition) => ({
		params: { id: exhibition.id },
		props: { exhibition },
	}));
}

const { exhibition } = Astro.props;
const [photos, note] = await Promise.all([photosForExhibition(exhibition.id), render(exhibition)]);
const dates = formatDateRange(exhibition.data.startDate, exhibition.data.endDate);
const hasBody = Boolean(exhibition.body?.trim());
const links = exhibition.data.links ?? [];
const primary = links[0];
---

<Base path={`exhibitions/${exhibition.id}/`} title={exhibition.data.title}>
	<main class="page stack">
		<PageHeader
			title={exhibition.data.title}
			body={hasBody}
			href={primary?.url}
			external={links.length === 1}
		>
			{
				(dates || links.length > 1) && (
					<Fragment slot="facts">
						{dates && <span>{dates}</span>}
						{links.length > 1 && <EntityLinks links={links} />}
					</Fragment>
				)
			}
			<TypeIcon slot="icon" type="exhibition" />
			<note.Content />
		</PageHeader>
		<PhotoGrid photos={photos} />
		{photos.length === 0 && <p>No photos yet.</p>}
	</main>
</Base>
