---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageFacts from '../../components/PageFacts.astro';
import TypeIcon from '../../components/TypeIcon.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import EntityLinks from '../../components/EntityLinks.astro';
import { getIndex, visitLocation } from '../../lib/content';
import { photosForVisit } from '../../lib/queries';
import { formatDate } from '../../lib/format';
import { route } from '../../lib/url';

export async function getStaticPaths() {
	const { visits } = await getIndex();
	return visits.map((visit) => ({ params: { id: visit.id }, props: { visit } }));
}

const { visit } = Astro.props;
const [photos, note, index] = await Promise.all([
	photosForVisit(visit.id),
	render(visit),
	getIndex(),
]);

const location = visitLocation(index, visit);
const exhibitions = (visit.data.exhibitions ?? [])
	.map((reference) => index.exhibitionById.get(reference.id))
	.filter((exhibition): exhibition is NonNullable<typeof exhibition> => Boolean(exhibition));

const date = visit.data.visitedAt;
const title =
	visit.data.name ?? location?.data.name ?? (date ? formatDate(date, 'long') : visit.id);
const hasBody = Boolean(visit.body?.trim());
const links = visit.data.links ?? [];
const primary = links[0];
---

<Base
	path={`visits/${visit.id}/`}
	title={title}
	description={location ? `Photos at ${location.data.name}.` : undefined}
	headingHref={primary?.url}
	headingExternal={links.length === 1}
>
	<TypeIcon slot="heading-icon" type="visit" />
	<main class="page stack">
		<PageFacts body={hasBody}>
			{
				(date ||
					(location && visit.data.name) ||
					exhibitions.length > 0 ||
					links.length > 1) && (
					<Fragment slot="facts">
						{date && (
							<span>
								<time datetime={date.toISOString().slice(0, 10)}>{formatDate(date, 'long')}</time>
							</span>
						)}
						{exhibitions.map((exhibition) => (
							<span>
								<a href={route(`exhibitions/${exhibition.id}/`)}>{exhibition.data.name}</a>
								<TypeIcon type="exhibition" class="icon-inline" />
							</span>
						))}
						{links.length > 1 && <EntityLinks links={links} />}
						{location && visit.data.name && (
							<span>
								<a href={route(`locations/${location.id}/`)}>{location.data.name}</a>
								<TypeIcon type="location" class="icon-inline" />
							</span>
						)}
					</Fragment>
				)
			}
						<note.Content />
		</PageFacts>
		<PhotoGrid photos={photos} />
		{photos.length === 0 && <p>No photos yet.</p>}
	</main>
</Base>
