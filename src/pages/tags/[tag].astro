---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import TypeIcon from '../../components/TypeIcon.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { getTag, getTags } from '../../lib/tags';
import { photosForTag } from '../../lib/queries';

export async function getStaticPaths() {
	const tags = await getTags();
	return tags.map((tag) => ({ params: { tag: tag.slug }, props: { slug: tag.slug } }));
}

const { slug } = Astro.props;
const [tag, photos] = await Promise.all([getTag(slug), photosForTag(slug)]);
const label = tag?.label ?? slug;
---

<Base path={`tags/${slug}/`} title={label} description={tag?.description}>
	<main class="page stack">
		<PageHeader title={label} body={false}>
			{
				tag?.description && (
					<Fragment slot="facts">
						<span>{tag.description}</span>
					</Fragment>
				)
			}
			<TypeIcon slot="icon" type="tag" />
		</PageHeader>
		<PhotoGrid photos={photos} />
		{photos.length === 0 && <p>No photos yet.</p>}
	</main>
</Base>
