---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TypeIcon from '../../components/TypeIcon.astro';
import PageHeader from '../../components/PageHeader.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import EntityLinks from '../../components/EntityLinks.astro';
import { getIndex } from '../../lib/content';
import { photosForArtist } from '../../lib/queries';

export async function getStaticPaths() {
	const { artists } = await getIndex();
	return artists.map((artist) => ({ params: { id: artist.id }, props: { artist } }));
}

const { artist } = Astro.props;
const [photos, note] = await Promise.all([photosForArtist(artist.id), render(artist)]);

const facts = [
	artist.data.country,
	...(artist.data.aliases?.length ? [`also ${artist.data.aliases.join(', ')}`] : []),
].filter(Boolean);
const hasBody = Boolean(artist.body?.trim());
const links = artist.data.links ?? [];
const primary = links[0];
---

<Base
	path={`artists/${artist.id}/`}
	title={artist.data.name}
	description={`Photos of work by ${artist.data.name}.`}
>
	<main class="page stack">
		<PageHeader
			title={artist.data.name}
			body={hasBody}
			href={primary?.url}
			external={links.length === 1}
		>
			{
				(facts.length > 0 || links.length > 1) && (
					<Fragment slot="facts">
						{facts.map((fact) => (
							<span>{fact}</span>
						))}
						{links.length > 1 && <EntityLinks links={links} />}
					</Fragment>
				)
			}
			<TypeIcon slot="icon" type="artist" />
			<note.Content />
		</PageHeader>
		<PhotoGrid photos={photos} />
		{photos.length === 0 && <p>No photos yet.</p>}
	</main>
</Base>
