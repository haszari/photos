---
import Base from '../../layouts/Base.astro';
import TypeIcon from '../../components/TypeIcon.astro';
import EntityList from '../../components/EntityList.astro';
import { getIndex } from '../../lib/content';
import { photosForArtist, featuredPhoto } from '../../lib/queries';

const { artists } = await getIndex();

const items = await Promise.all(
	artists.map(async (artist) => {
		const photos = await photosForArtist(artist.id);
		return {
			href: `artists/${artist.id}/`,
			label: artist.data.name,
			photo: featuredPhoto(photos, artist.data.featuredPhoto),
		};
	}),
);
---

<Base path="artists/" title="Artists">
	<TypeIcon slot="heading-icon" type="artist" />
	<main class="page stack">
		<EntityList items={items} />
		{items.length === 0 && <p>No artists yet.</p>}
	</main>
</Base>
